# Copy to .env before running Prisma CLI commands (migrate, seed, studio).
# The app itself falls back to this same value when .env is absent.
DATABASE_URL="file:./dev.db"

# Optional: where uploaded screenshots are stored (defaults to ./uploads).
# In production, point BOTH of these at a persistent disk, e.g. on Render:
# DATABASE_URL="file:/var/data/dev.db"
# UPLOADS_DIR="/var/data/uploads"
